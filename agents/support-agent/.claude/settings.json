{
  "model": "claude-haiku-4-5",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "support"
  ],
  "permissions": {
    "allow": [
      "mcp__support"
    ],
    "deny": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  }
}
